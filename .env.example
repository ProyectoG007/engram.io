# ============================================
# B'H SAAS - VARIABLES DE ENTORNO
# Protocolo TITAN - 9 Capas
# ============================================

# --------------------------------------------
# CAPA 1: PRESENTACIÓN (Next.js)
# --------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="B'H SaaS"

# --------------------------------------------
# CAPA 2: AUTENTICACIÓN (NextAuth)
# --------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu-super-secret-aqui

# Auth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --------------------------------------------
# CAPA 4: SERVICIOS EXTERNOS
# --------------------------------------------

# Together AI (RAG + Embeddings)
TOGETHER_API_KEY=

# AI Providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Pinecone (Vector Database)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bh-saas-rag
PINECONE_ENVIRONMENT=us-east-1

# --------------------------------------------
# CAPA 5: PERSISTENCIA
# --------------------------------------------

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/bh_saas?schema=public"

# Redis (Cache + Sessions)
REDIS_URL=redis://localhost:6379

# Engram (Memory RAG)
ENGRAM_DB_PATH=./data/engram.db

# --------------------------------------------
# CAPA 7: LOGS Y MONITOREO
# --------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# LangSmith (Tracing)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=bh-saas

# --------------------------------------------
# TELEGRAM BOT
# --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# --------------------------------------------
# AGENTS (Gentle-AI / Agent Teams)
# --------------------------------------------
AGENT_TEAMS_PATH=./agent-teams-lite
GENTLE_AI_PATH=./gentle-ai
