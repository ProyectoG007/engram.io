# Dockerfile for Telegram Bot
FROM node:20-alpine

WORKDIR /app

# Instalar dependencias (incluyendo devDeps para tsx y prisma)
COPY package.json package-lock.json* ./
RUN npm ci

# Copiar código y schema
COPY prisma/ ./prisma/
COPY src/ ./src/
COPY tsconfig.json .

# Generar cliente Prisma
RUN npx prisma generate

# Variables de entorno
ENV NODE_ENV=production

# Iniciar bot
CMD ["npx", "tsx", "src/telegram/bot.ts"]
